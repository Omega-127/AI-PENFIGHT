# AI Penfight Backend — Production Environment Variables (Render)
# Configure these variables in the Render Dashboard under Environment

APP_NAME=AI Penfight Backend
ENVIRONMENT=production
LOG_LEVEL=info

# Set to your deployed Vercel frontend URL(s), comma-separated (no trailing slash)
ALLOWED_ORIGINS=https://ai-penfight.vercel.app,https://your-custom-domain.com

# LLM Provider: 'fallback' (mock, zero cost), 'openai', or 'anthropic'
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-proj-your-production-key-here

# Reliability and rate management
LLM_TIMEOUT=30.0
LLM_MAX_TOKENS=2048
LLM_RETRIES=2

# Input validation constraints
MAX_INPUT_LENGTH=5000
MIN_INPUT_LENGTH=2
MIN_WORDS_FOR_LLM=8
FORCE_RULE_BASED=false
