# AI Penfight Environment Configuration Example
# Copy this file to .env and provide your secret credentials.

# Application Configuration
APP_NAME=AI Penfight Backend
ENVIRONMENT=development
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM Provider Configuration
# Supported providers: fallback (zero credentials required), openai, anthropic
LLM_PROVIDER=fallback
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_api_key_here
LLM_TIMEOUT=30.0
LLM_MAX_TOKENS=2048
LLM_RETRIES=2

# Input Constraints
MAX_INPUT_LENGTH=5000
MIN_INPUT_LENGTH=2
MIN_WORDS_FOR_LLM=8
FORCE_RULE_BASED=false
